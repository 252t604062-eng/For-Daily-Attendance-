function todayStr() {
  const d = new Date();
  const off = d.getTimezoneOffset();
  const local = new Date(d.getTime() - off * 60000);
  return local.toISOString().slice(0, 10);
}

function fmtDateLabel(str) {
  const [y,m,d] = str.split('-').map(Number);
  const dt = new Date(y, m-1, d);
  return dt.toLocaleDateString(undefined, { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' });
}

function genId() {
  return 's_' + Date.now() + '_' + Math.random().toString(36).slice(2,8);
}

async function loadStudents() {
  try {
    const res = await window.storage.get('students', false);
    students = res ? JSON.parse(res.value) : [];
  } catch (e) {
    students = [];
  }
}

async function saveStudents() {
  try {
    await window.storage.set('students', JSON.stringify(students), false);
  } catch (e) { console.error('save students failed', e); }
}

async function loadAttendance(dateStr) {
  try {
    const res = await window.storage.get('attendance:' + dateStr, false);
    attendance = res ? JSON.parse(res.value) : {};
  } catch (e) {
    attendance = {};
  }
}

async function saveAttendance(dateStr) {
  try {
    await window.storage.set('attendance:' + dateStr, JSON.stringify(attendance), false);
  } catch (e) { console.error('save attendance failed', e); }
}

function nextTicketSuggestion() {
  if (students.length === 0) return '';
  const nums = students
    .map(s => s.ticket.match(/(\d+)$/))
    .filter(Boolean)
    .map(m => ({ full: m[0], num: parseInt(m[1], 10) }));
  if (nums.length === 0) return '';
  const max = nums.reduce((a,b) => b.num > a.num ? b : a);
  const last = students.find(s => s.ticket.endsWith(max.full));
  const prefix = last.ticket.slice(0, last.ticket.length - max.full.length);
  const width = max.full.length;
  const nextNum = (max.num + 1).toString().padStart(width, '0');
  return prefix + nextNum;
}

function render() {
  subtitleEl.textContent = fmtDateLabel(currentDate);

  const q = searchInput.value.trim().toLowerCase();
  const filtered = students.filter(s =>
    s.name.toLowerCase().includes(q) || s.ticket.toLowerCase().includes(q)
  );

  let pCount = 0, aCount = 0;
  students.forEach(s => {
    const st = attendance[s.id];
    if (st === 'P') pCount++;
    else if (st === 'A') aCount++;
  });
  summaryEl.innerHTML = students.length
    ? `<b class="p">${pCount}P</b> · <b class="a">${aCount}A</b> · ${students.length - pCount - aCount} unmarked`
    : '';

  if (students.length === 0) {
    listEl.innerHTML = `<div class="empty"><span>No students yet</span>Tap "+ Add student" to build your roster.</div>`;
    return;
  }
  if (filtered.length === 0) {
    listEl.innerHTML = `<div class="empty"><span>No matches</span>Try a different name or hall ticket.</div>`;
    return;
  }

  listEl.innerHTML = filtered.map((s, i) => {
    const status = attendance[s.id] || '';
    const label = status === 'P' ? 'P' : status === 'A' ? 'A' : '—';
    return `
      <div class="row" data-id="${s.id}">
        <div class="idx">${i + 1}</div>
        <div class="info">
          <div class="name">${escapeHtml(s.name)}</div>
          <div class="ticket">${escapeHtml(s.ticket)}</div>
        </div>
        <button class="status-btn" data-status="${status}" data-action="toggle">${label}</button>
        <button class="edit-btn" data-action="edit">✎</button>
      </div>
    `;
  }).join('');
}

function escapeHtml(str) {
  const d = document.createElement('div');
  d.textContent = str;
  return d.innerHTML;
}

listEl.addEventListener('click', async (e) => {
  const btn = e.target.closest('button');
  if (!btn) return;
  const row = e.target.closest('.row');
  const id = row.dataset.id;
  if (btn.dataset.action === 'toggle') {
    const cur = attendance[id];
    const next = cur === 'P' ? 'A' : cur === 'A' ? '' : 'P';
    if (next === '') delete attendance[id];
    else attendance[id] = next;
    render();
    await saveAttendance(currentDate);
  } else if (btn.dataset.action === 'edit') {
    openEditModal(id);
  }
});

document.getElementById('addBtn').addEventListener('click', () => openEditModal(null));
searchInput.addEventListener('input', render);
dateInput.addEventListener('change', async () => {
  currentDate = dateInput.value;
  await loadAttendance(currentDate);
  render();
});
document.getElementById('prevDay').addEventListener('click', async () => {
  const d = new Date(currentDate + 'T00:00:00');
  d.setDate(d.getDate() - 1);
  currentDate = d.toISOString().slice(0,10);
  dateInput.value = currentDate;
  await loadAttendance(currentDate);
  render();
});
document.getElementById('nextDay').addEventListener('click', async () => {
  const d = new Date(currentDate + 'T00:00:00');
  d.setDate(d.getDate() + 1);
  currentDate = d.toISOString().slice(0,10);
  dateInput.value = currentDate;
  await loadAttendance(currentDate);
  render();
});

function openEditModal(id) {
  const existing = id ? students.find(s => s.id === id) : null;
  const overlay = document.createElement('div');
  overlay.className = 'overlay';
  overlay.innerHTML = `
    <div class="sheet">
      <h2>${existing ? 'Edit student' : 'Add student'}</h2>
      <label>Name</label>
      <input type="text" id="fName" value="${existing ? escapeHtml(existing.name) : ''}" placeholder="e.g. A.P Vyshali">
      <label>Hall ticket</label>
      <input type="text" id="fTicket" value="${existing ? escapeHtml(existing.ticket) : nextTicketSuggestion()}" placeholder="e.g. 252TA04016">
      <div class="btn-row">
        ${existing ? '<button class="btn-delete" id="fDelete">Delete</button>' : ''}
        <button class="btn-cancel" id="fCancel">Cancel</button>
        <button class="btn-save" id="fSave">Save</button>
      </div>
    </div>
  `;
  modalRoot.appendChild(overlay);
  const nameInput = overlay.querySelector('#fName');
  const ticketInput = overlay.querySelector('#fTicket');
  nameInput.focus();

  overlay.querySelector('#fCancel').addEventListener('click', () => overlay.remove());
  overlay.addEventListener('click', (e) => { if (e.target === overlay) overlay.remove(); });

  if (existing) {
    overlay.querySelector('#fDelete').addEventListener('click', async () => {
      students = students.filter(s => s.id !== existing.id);
      delete attendance[existing.id];
      await saveStudents();
      await saveAttendance(currentDate);
      overlay.remove();
      render();
    });
  }

  overlay.querySelector('#fSave').addEventListener('click', async () => {
    const name = nameInput.value.trim();
    const ticket = ticketInput.value.trim();
    if (!name || !ticket) return;
    if (existing) {
      existing.name = name;
      existing.ticket = ticket;
    } else {
      students.push({ id: genId(), name, ticket });
    }
    await saveStudents();
    overlay.remove();
    render();
  });
}

async function init() {
  currentDate = todayStr();
  dateInput.value = currentDate;
  await loadStudents();
  await loadAttendance(currentDate);
  ready = true;
  render();
}

init();
</script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Attendance</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Patrick+Hand&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
  :root {
    --paper: #FAF7F1;
    --card: #FFFFFF;
    --ink: #2B2B26;
    --ink-soft: #6B6A63;
    --line: #E7E3D8;
    --sage: #6B9080;
    --sage-bg: #E3EDE7;
    --coral: #E07A5F;
    --coral-bg: #FBE6E0;
    --gold: #D4A24C;
    --gold-bg: #FBF0DD;
  }
  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: 'Nunito', sans-serif;
    padding-bottom: 40px;
  }
  header {
    position: sticky;
    top: 0;
    background: var(--paper);
    z-index: 10;
    padding: 18px 16px 10px;
    border-bottom: 1px solid var(--line);
  }
  h1 {
    font-family: 'Patrick Hand', cursive;
    font-size: 2rem;
    margin: 0 0 4px;
    letter-spacing: 0.3px;
  }
  .subtitle {
    font-size: 0.82rem;
    color: var(--ink-soft);
    margin: 0 0 14px;
  }
  .date-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }
  .date-row button.nav {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    width: 38px;
    height: 38px;
    font-size: 1.1rem;
    color: var(--ink-soft);
    flex-shrink: 0;
  }
  .date-row input[type="date"] {
    flex: 1;
    font-family: 'Nunito', sans-serif;
    font-weight: 700;
    font-size: 1rem;
    padding: 9px 10px;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: var(--card);
    color: var(--ink);
  }
  .search-row {
    display: flex;
    gap: 8px;
    margin-bottom: 10px;
  }
  .search-row input {
    flex: 1;
    font-family: 'Nunito', sans-serif;
    font-size: 0.95rem;
    padding: 10px 12px;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: var(--card);
    color: var(--ink);
  }
  .search-row input::placeholder { color: var(--ink-soft); }
  .actions-row {
    display: flex;
    gap: 8px;
    align-items: center;
  }
  button.primary {
    background: var(--sage);
    color: white;
    border: none;
    border-radius: 10px;
    padding: 10px 16px;
    font-family: 'Nunito', sans-serif;
    font-weight: 700;
    font-size: 0.9rem;
  }
  .summary {
    font-size: 0.8rem;
    color: var(--ink-soft);
    margin-left: auto;
  }
  .summary b.p { color: var(--sage); }
  .summary b.a { color: var(--coral); }

  main { padding: 12px 16px; }
  .empty {
    text-align: center;
    color: var(--ink-soft);
    padding: 60px 20px;
    font-size: 0.95rem;
  }
  .empty span { font-family: 'Patrick Hand', cursive; font-size: 1.3rem; display: block; margin-bottom: 6px; color: var(--ink); }

  .row {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 12px 12px;
    margin-bottom: 8px;
  }
  .row .idx {
    font-size: 0.75rem;
    color: var(--ink-soft);
    width: 20px;
    text-align: center;
    flex-shrink: 0;
  }
  .row .info { flex: 1; min-width: 0; }
  .row .name { font-weight: 700; font-size: 0.98rem; }
  .row .ticket { font-size: 0.75rem; color: var(--ink-soft); font-variant-numeric: tabular-nums; }

  .status-btn {
    flex-shrink: 0;
    border: none;
    border-radius: 10px;
    width: 56px;
    height: 40px;
    font-family: 'Patrick Hand', cursive;
    font-size: 1.15rem;
    font-weight: 400;
    background: var(--gold-bg);
    color: var(--gold);
  }
  .status-btn[data-status="P"] { background: var(--sage-bg); color: var(--sage); }
  .status-btn[data-status="A"] { background: var(--coral-bg); color: var(--coral); }

  .edit-btn {
    flex-shrink: 0;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 10px;
    width: 38px;
    height: 38px;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .overlay {
    position: fixed;
    inset: 0;
    background: rgba(43,43,38,0.4);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    z-index: 50;
  }
  .sheet {
    background: var(--card);
    width: 100%;
    max-width: 480px;
    border-radius: 18px 18px 0 0;
    padding: 20px 18px 28px;
  }
  .sheet h2 {
    font-family: 'Patrick Hand', cursive;
    font-size: 1.4rem;
    margin: 0 0 14px;
  }
  .sheet label {
    display: block;
    font-size: 0.78rem;
    color: var(--ink-soft);
    margin-bottom: 4px;
    margin-top: 12px;
  }
  .sheet input {
    width: 100%;
    font-family: 'Nunito', sans-serif;
    font-size: 0.95rem;
    padding: 10px 12px;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: var(--paper);
    color: var(--ink);
  }
  .sheet .btn-row {
    display: flex;
    gap: 10px;
    margin-top: 20px;
  }
  .sheet .btn-row button {
    flex: 1;
    padding: 11px;
    border-radius: 10px;
    font-family: 'Nunito', sans-serif;
    font-weight: 700;
    font-size: 0.9rem;
    border: none;
  }
  .btn-cancel { background: var(--paper); color: var(--ink-soft); border: 1px solid var(--line) !important; }
  .btn-save { background: var(--sage); color: white; }
  .btn-delete { background: var(--coral-bg); color: var(--coral); }
  .status-msg {
    font-size: 0.75rem;
    color: var(--ink-soft);
    text-align: center;
    padding: 8px;
  }
</style>
</head>
<body>

<header>
  <h1>Attendance</h1>
  <p class="subtitle" id="subtitle">Loading your roster…</p>
  <div class="date-row">
    <button class="nav" id="prevDay">‹</button>
    <input type="date" id="dateInput">
    <button class="nav" id="nextDay">›</button>
  </div>
  <div class="search-row">
    <input type="text" id="search" placeholder="Search name or hall ticket">
  </div>
  <div class="actions-row">
    <button class="primary" id="addBtn">+ Add student</button>
    <div class="summary" id="summary"></div>
  </div>
</header>

<main id="list"></main>

<div id="modalRoot"></div>

<script>
const dateInput = document.getElementById('dateInput');
const searchInput = document.getElementById('search');
const listEl = document.getElementById('list');
const summaryEl = document.getElementById('summary');
const subtitleEl = document.getElementById('subtitle');
const modalRoot = document.getElementById('modalRoot');

let students = [];
let attendance = {}; // { studentId: 'P' | 'A' }
let currentDate = todayStr();
let ready = false;

const DEFAULT_ROSTER = [
